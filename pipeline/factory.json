{
 "factory": "issue-to-pr",
 "max_retries": 2,
 "nodes": [
  {
   "id": "plan",
   "kind": "agent",
   "role": "producer",
   "read_only": true,
   "prompt_file": "plan.md",
   "tools": [
    "Read",
    "Grep",
    "Glob",
    "Bash"
   ],
   "max_turns": 25,
   "max_budget_usd": 1.5,
   "timeout_seconds": 1800
  },
  {
   "id": "implement",
   "kind": "agent",
   "prompt_file": "implement.md",
   "inputs": [
    "plan"
   ],
   "tools": [
    "Read",
    "Edit",
    "Write",
    "Grep",
    "Glob",
    "Bash"
   ],
   "max_turns": 50,
   "max_budget_usd": 4,
   "timeout_seconds": 1800
  },
  {
   "id": "tests",
   "kind": "code",
   "read_only": true,
   "retry": "implement",
   "command": [
    "bash",
    "{spec_dir}/check.sh"
   ],
   "timeout_seconds": 900
  },
  {
   "id": "review",
   "kind": "agent",
   "read_only": true,
   "retry": "implement",
   "prompt_file": "review.md",
   "inputs": [
    "plan",
    "implement"
   ],
   "tools": [
    "Read",
    "Grep",
    "Glob",
    "Bash"
   ],
   "max_turns": 30,
   "max_budget_usd": 2,
   "timeout_seconds": 1800
  },
  {
   "id": "output",
   "kind": "code",
   "read_only": true,
   "command": [
    "bash",
    "{spec_dir}/open-pr.sh",
    "{run_dir}",
    "{base_commit}"
   ],
   "timeout_seconds": 300
  }
 ]
}
