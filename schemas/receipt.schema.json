{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gentle-factory:schema:receipt:0.1",
  "title": "gentle-factory Node Completion Receipt",
  "description": "Tamper-evident, in-toto v1.0-compliant completion receipt for gentle-factory workflow nodes.",
  "type": "object",
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "additionalProperties": false,
  "properties": {
    "_type": {
      "type": "string",
      "const": "https://in-toto.io/Statement/v1",
      "description": "in-toto v1.0 statement envelope identifier."
    },
    "subject": {
      "type": "array",
      "description": "Artifacts produced or verified by this node (e.g., git commit, workspace state).",
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Artifact name or URI (e.g., git:commit, pull_request, workspace:diff)."
          },
          "digest": {
            "type": "object",
            "description": "Cryptographic digest map (e.g. sha256, gitCommit).",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "predicateType": {
      "type": "string",
      "const": "https://fullfran.com/spec/gentle-factory/receipt/v0.1",
      "description": "URI identifying the gentle-factory node receipt predicate schema."
    },
    "predicate": {
      "type": "object",
      "required": [
        "version",
        "run_id",
        "step",
        "references",
        "execution",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[a-zA-Z0-9.]+)?$",
          "description": "SemVer version of the receipt format."
        },
        "run_id": {
          "type": "string",
          "description": "Unique identifier of the factory run instance."
        },
        "step": {
          "type": "object",
          "required": [
            "node_id",
            "node_kind",
            "attempt"
          ],
          "additionalProperties": false,
          "properties": {
            "node_id": {
              "type": "string",
              "description": "Identifier of the pipeline node (e.g., implement, verify, design_gate)."
            },
            "node_kind": {
              "type": "string",
              "enum": [
                "code",
                "agent",
                "human_gate"
              ],
              "description": "Execution kind of the node."
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "description": "1-based attempt sequence number for this node within the run."
            }
          }
        },
        "references": {
          "type": "object",
          "required": [
            "repository",
            "issue",
            "design_comment"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "description": "GitHub repository in owner/repo format."
            },
            "issue": {
              "type": "object",
              "required": [
                "number",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "design_comment": {
              "type": "object",
              "required": [
                "id",
                "url",
                "sha256",
                "updated_at"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "SHA-256 digest of the design comment body at execution time."
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 timestamp of last comment update."
                }
              }
            },
            "vcs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "base_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "Baseline git commit SHA before node execution."
                },
                "head_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "Head git commit SHA produced or observed by this node."
                },
                "branch": {
                  "type": "string",
                  "description": "Git working branch name."
                },
                "pull_request": {
                  "type": "object",
                  "required": [
                    "number",
                    "url"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "draft": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "required": [
            "engine",
            "tools_allowed"
          ],
          "additionalProperties": false,
          "properties": {
            "engine": {
              "type": "string",
              "description": "Execution runner (e.g. claude-code-headless, bash, github-gate)."
            },
            "engine_version": {
              "type": "string"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Command line invoked by the harness."
            },
            "tools_allowed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tool permission grant or whitelist provided to the node."
            },
            "caps": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_turns": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_budget_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trace_id": {
              "type": "string",
              "description": "W3C / OpenTelemetry Trace ID (32 hex characters)."
            },
            "span_id": {
              "type": "string",
              "description": "W3C / OpenTelemetry Span ID (16 hex characters)."
            },
            "traceparent": {
              "type": "string",
              "description": "W3C traceparent header string."
            },
            "gen_ai_system": {
              "type": "string",
              "description": "OpenTelemetry semantic convention gen_ai.system (e.g. anthropic)."
            },
            "request_model": {
              "type": "string",
              "description": "OpenTelemetry semantic convention gen_ai.request.model."
            },
            "tokens": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "total_cost_usd": {
              "type": "number",
              "minimum": 0,
              "description": "Total monetary cost in USD reported by engine or harness meter."
            },
            "num_turns": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of agent conversational turns consumed."
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Elapsed wall-clock time in milliseconds."
            }
          }
        },
        "outcome": {
          "type": "object",
          "required": [
            "status",
            "terminal_reason"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "success",
                "failure",
                "needs_decision",
                "misconfigured"
              ],
              "description": "High-level node execution status."
            },
            "terminal_reason": {
              "type": "string",
              "description": "Deterministic reason string (e.g. completed, gate_failed, max_turns_exceeded, timeout, user_decision_required)."
            },
            "exit_code": {
              "type": "integer",
              "description": "Process exit code if applicable."
            }
          }
        },
        "gate": {
          "type": "object",
          "required": [
            "status",
            "verdict_line"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "GREEN",
                "RED",
                "MISCONFIGURED"
              ],
              "description": "Verdict status parsed from gate script."
            },
            "verdict_line": {
              "type": "string",
              "description": "Exact machine-readable verdict line (e.g. FACTORY_GATES: status=GREEN)."
            },
            "checks_passed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "checks_failed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "failure_signature": {
          "type": "string",
          "description": "Deterministic fingerprint (e.g. sha256 or normalized error token) used by runner to bound identical failure retries.",
          "minLength": 1
        },
        "materials": {
          "type": "array",
          "description": "in-toto materials: input files and dependencies consumed by the node.",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "digest"
            ],
            "additionalProperties": false,
            "properties": {
              "uri": {
                "type": "string"
              },
              "digest": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "products": {
          "type": "array",
          "description": "in-toto products: output files and artifacts created/modified by the node.",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "digest"
            ],
            "additionalProperties": false,
            "properties": {
              "uri": {
                "type": "string"
              },
              "digest": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "description": "Concise non-identifying operational summary or diagnostic details."
        }
      },
      "allOf": [
        {
          "description": "A success outcome cannot carry a failing exit code or a non-GREEN gate verdict.",
          "if": {
            "properties": {
              "outcome": {
                "properties": {
                  "status": {
                    "const": "success"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "properties": {
                  "exit_code": {
                    "const": 0
                  }
                }
              },
              "gate": {
                "properties": {
                  "status": {
                    "const": "GREEN"
                  }
                }
              }
            }
          }
        },
        {
          "description": "Every failure receipt records the failure_signature the identical-failure guard compares.",
          "if": {
            "properties": {
              "outcome": {
                "properties": {
                  "status": {
                    "const": "failure"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "failure_signature"
            ]
          }
        },
        {
          "description": "Code and agent nodes bind their receipt to the commit they produced or observed, so a later code change makes the receipt stale.",
          "if": {
            "properties": {
              "step": {
                "properties": {
                  "node_kind": {
                    "enum": [
                      "code",
                      "agent"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "references"
            ],
            "properties": {
              "references": {
                "required": [
                  "vcs"
                ],
                "properties": {
                  "vcs": {
                    "required": [
                      "head_commit"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
